# ── Database ──────────────────────────────────────────────
# DATABASE_URL (owner role) is used by Alembic migrations only — it is
# superuser + BYPASSRLS (see the 2026-07-15 RLS spike finding in
# DECISION_LOG.md) and must never be what the running app connects as.
POSTGRES_USER=lexireview
POSTGRES_PASSWORD=lexireview_dev
POSTGRES_DB=lexireview
DATABASE_URL=postgresql://lexireview:lexireview_dev@postgres:5432/lexireview

# APP_USER_PASSWORD: password for the non-superuser app_user role created by
# migration 001. Change this from the placeholder before any non-local use.
APP_USER_PASSWORD=change_me_generate_a_long_random_string
# APP_DATABASE_URL: what the api/worker containers actually connect as
# (RLS-enforced). Set explicitly in docker-compose.yml from APP_USER_PASSWORD;
# listed here for reference / non-compose setups.
APP_DATABASE_URL=postgresql://app_user:change_me_generate_a_long_random_string@postgres:5432/lexireview

# ── Outbox relay (migration 011 + app/relay.py) ────────────────────────
# RELAY_USER_PASSWORD: password for the non-superuser `relay` role created by
# migration 011 (outbox). Change this from the placeholder before any non-local
# use, same as APP_USER_PASSWORD.
RELAY_USER_PASSWORD=change_me_generate_a_long_random_string
# RELAY_DATABASE_URL: what app/relay.py's sweep_outbox() connects as (outbox
# SELECT+UPDATE only, no user-table access). Set on docker-compose.yml's
# `worker` service, not `relay` -- `celery beat` (the `relay` service) only
# ticks the schedule by task name; the task body executes wherever the queue
# is consumed, which is `worker`.
RELAY_DATABASE_URL=postgresql://relay:change_me_generate_a_long_random_string@postgres:5432/lexireview

# ── Queue / cache ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object store (MinIO locally, S3 in prod) ──────────────
MINIO_ROOT_USER=lexireview
MINIO_ROOT_PASSWORD=lexireview_dev_secret
S3_ENDPOINT=http://minio:9000
S3_BUCKET=documents

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_me_generate_a_long_random_string
# ENVIRONMENT=development disables the Secure flag on the access-token
# cookie -- required for local dev over plain http://localhost, since
# browsers silently drop Secure cookies there. Fail-safe default is
# secure (any value other than exactly "development", including unset,
# keeps Secure on). docker-compose.yml sets this for the api service
# directly so local compose dev works without editing this file.
ENVIRONMENT=production

# ── LLM provider (provider-agnostic client) ───────────────
# gemini_free = dev tier. SYNTHETIC_ONLY must stay true on any free tier:
# free-tier data may be used for provider training -> real docs are FORBIDDEN.
LLM_PROVIDER=gemini_free
GEMINI_API_KEY=your_google_ai_studio_key_here
ANTHROPIC_API_KEY=            # filled in pilot phase (paid, no-training)
LLM_MODEL=gemini-flash        # pinned; changing it requires the regression gate
SYNTHETIC_ONLY=true

# ── Preflight gate caps ───────────────────────────────────
MAX_UPLOAD_MB=50
MAX_PAGES=100
